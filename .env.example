# Copy to .env and fill what you use. Everything here is optional —
# the site builds and runs with all of these blank.
# All client-exposed vars MUST be prefixed PUBLIC_.

# Canonical site URL (used for OG tags, sitemap, JSON-LD).
PUBLIC_SITE_URL=https://example.com

# Cloudflare Turnstile site key for the contact form (optional).
PUBLIC_TURNSTILE_SITE_KEY=

# ── Analytics — every tracker is independent; set only what you use ──
# Google Tag Manager (recommended if you want to manage tags in the GTM UI)
# PUBLIC_GTM_CONTAINER_ID=GTM-XXXXXXX

# Google Analytics 4 (direct, if not going through GTM)
# PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta (Facebook) Pixel
# PUBLIC_META_PIXEL_ID=000000000000000

# TikTok Pixel
# PUBLIC_TIKTOK_PIXEL_ID=CXXXXXXXXXXXXX

# Cookieless first-party analytics (Plausible or Umami) — optional, layers on top
# PUBLIC_ANALYTICS_PROVIDER=plausible
# PUBLIC_ANALYTICS_DOMAIN=example.com
# PUBLIC_ANALYTICS_PROVIDER=umami
# PUBLIC_UMAMI_WEBSITE_ID=
# PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
