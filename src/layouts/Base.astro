---
import '~/styles/base.css';
import { site } from '~/lib/site';
import JsonLd from '~/components/JsonLd.astro';
import Analytics from '~/components/Analytics.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  pageType?: 'WebPage' | 'Article' | 'ContactPage' | 'AboutPage';
}

const {
  title,
  description = site.description,
  image,
  noindex = false,
  pageType = 'WebPage',
} = Astro.props;

const fullTitle = title ? `${title} - ${site.name}` : `${site.name} - ${site.tagline}`;
// astro.config.mjs `site` (PUBLIC_SITE_URL) wins; site.ts is the fallback.
const base = Astro.site?.toString() ?? site.url;
const canonical = new URL(Astro.url.pathname, base).toString();
const ogImage = new URL(image ?? site.ogImage, base).toString();

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: base,
  jobTitle: site.role,
  email: `mailto:${site.contactEmail}`,
  sameAs: [site.linkedin, site.github],
};

const siteLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: base };
const pageLd = { '@context': 'https://schema.org', '@type': pageType, name: fullTitle, url: canonical, description, image: ogImage, inLanguage: site.locale };
---
<!doctype html>
<html lang="en" data-chapter="0" style="--film-progress: 0">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0f" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" type="image/x-icon" href="/assets/brand/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/brand/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <JsonLd data={[personLd, siteLd, pageLd]} />
    <Analytics />
    <slot name="head" />
  </head>
  <body >
    {/* GTM noscript fallback — mirrors the head bootstrap in Analytics.astro; off unless set. */}
    {import.meta.env.PUBLIC_GTM_CONTAINER_ID && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${import.meta.env.PUBLIC_GTM_CONTAINER_ID}`}
          height="0" width="0"
          style="display:none;visibility:hidden"
        ></iframe>
      </noscript>
    )}
    <slot name="header" />
    <main><slot /></main>
    <slot name="footer" />
  </body>
</html>
