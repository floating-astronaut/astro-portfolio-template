---
import Base from '~/layouts/Base.astro';
import ScrollFilm from '~/components/ScrollFilm.astro';
import FloatingHeader from '~/components/FloatingHeader.astro';
import FloatingFooter from '~/components/FloatingFooter.astro';
import Hero from '~/components/sections/Hero.astro';
import Capabilities from '~/components/sections/Capabilities.astro';
import Projects from '~/components/sections/Projects.astro';
import Experience from '~/components/sections/Experience.astro';
import Contact from '~/components/sections/Contact.astro';
import LogoMarquee from '~/components/LogoMarquee.astro';
import { primary, secondary } from '~/data/capabilities';
---
<Base>
  <FloatingHeader slot="header" />
  <ScrollFilm>
    <Hero />
    <LogoMarquee />
    <Capabilities id="skills" kicker="What I do" title="The work I'm hired for."
      lede="One line on the value you bring. Edit these cards in src/data/capabilities.ts." items={primary} />
    <Capabilities id="craft" kicker="How I work" title="The tools and habits behind it."
      lede="A second group of six — or delete this section if one is enough." items={secondary} />
    <Projects />
    <Experience />
    <Contact />
  </ScrollFilm>
  <FloatingFooter slot="footer" />
</Base>
<script>
  import '~/scripts/tilt';
</script>
<script>
  // Reveal content as it enters; without JS (or with reduced motion) it is simply visible.
  const root = document.documentElement;
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    root.classList.add('js-reveal');
    const io = new IntersectionObserver((entries) => entries.forEach((entry) => {
      if (entry.isIntersecting) { entry.target.classList.add('is-in'); io.unobserve(entry.target); }
    }), { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  }
</script>
