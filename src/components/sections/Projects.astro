---
import { projects } from '~/data/projects';
// The first four fill a 2x2 of square tiles; any further project gets a full-width bar below.
const squares = projects.slice(0, 4);
const wide = projects.slice(4);
---
<section class="section" id="projects" aria-labelledby="projects-title">
  <p class="section__kicker reveal">Projects</p>
  <h2 id="projects-title" class="section__title reveal">Selected work.</h2>
  <p class="section__lede reveal">Four tiles and one featured project. Edit them in src/data/projects.ts.</p>
  <ul class="projects" role="list">
    {squares.map((project) => (
      <li class="glass project reveal" data-tilt>
        <img class="project__shot" src={project.cover} alt="" width="900" height="563" loading="lazy" decoding="async" />
        <div class="project__shade" aria-hidden="true"></div>
        <div class="project__top">
          <span class:list={['chip', { 'chip--accent': project.status === 'LIVE' }]}>{project.status === 'LIVE' ? 'Live' : 'In progress'}</span>
          <span class="project__index" aria-hidden="true">0{project.index}</span>
        </div>
        <div class="project__body">
          <h3 class="project__name">{project.name}</h3>
          <p class="project__pitch">{project.pitch}</p>
          <ul class="project__facts" role="list">{project.facts.map((fact) => <li class="chip">{fact}</li>)}</ul>
          <p class="project__role">My role: {project.role}</p>
          {project.href
            ? <a class="project__link" href={project.href} target="_blank" rel="noopener">Visit {project.name} <span aria-hidden="true">↗</span></a>
            : <p class="project__soon">Coming soon.</p>}
        </div>
      </li>
    ))}
  </ul>
  {wide.map((project) => (
    <div class="glass upcoming reveal" data-tilt>
      <img class="upcoming__shot" src={project.cover} alt="" width="900" height="563" loading="lazy" decoding="async" />
      <div class="upcoming__body">
        <p class="upcoming__meta">
          <span class:list={['chip', { 'chip--accent': project.status === 'LIVE' }]}>{project.status === 'LIVE' ? 'Live' : 'In progress'}</span>
          <span class="project__index" aria-hidden="true">0{project.index}</span>
        </p>
        <h3 class="project__name">{project.name}</h3>
        <p class="project__pitch">{project.pitch}</p>
        <ul class="project__facts" role="list">{project.facts.map((fact) => <li class="chip">{fact}</li>)}</ul>
        <p class="project__role">My role: {project.role}</p>
      </div>
      {project.href
        ? <a class="project__link upcoming__cta" href={project.href} target="_blank" rel="noopener">Visit {project.name} <span aria-hidden="true">↗</span></a>
        : <p class="project__soon upcoming__soon">Launching soon.</p>}
    </div>
  ))}
</section>
<style>
  .projects {
    list-style: none; padding: 0; margin: clamp(22px, 3vw, 36px) 0 0;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px;
  }
  /* Square tiles: the product fills the box, copy sits on a dark fade at the bottom. */
  .project {
    position: relative; aspect-ratio: 1 / 1; overflow: hidden; border-radius: 26px;
    display: flex; flex-direction: column; justify-content: space-between; padding: clamp(18px, 2.2vw, 26px);
    isolation: isolate; transition: transform .4s ease, border-color .4s ease;
  }
  /* Product window in the top half, fading into the glass; copy below never overlaps it. */
  .project__shot {
    position: absolute; inset: 0 0 auto; z-index: -2; width: 100%; height: 58%;
    object-fit: cover; object-position: 88% 0; opacity: .9;
    -webkit-mask-image: linear-gradient(180deg, #000 55%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 55%, transparent 100%);
    transform: scale(1.02); transform-origin: 70% 0; transition: transform .8s cubic-bezier(.2,.7,.2,1), opacity .5s ease;
  }
  .project__shade {
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(180deg, rgb(4 10 7 / 30%) 0%, rgb(4 10 7 / 0%) 22%, rgb(4 10 7 / 0%) 40%, rgb(4 10 7 / 55%) 62%);
  }
  .project:hover { transform: translateY(-5px); border-color: rgb(61 255 143 / 40%); }
  .project:hover .project__shot { transform: scale(1.08); opacity: 1; }
  .project__top { display: flex; justify-content: space-between; align-items: center; }
  .project__index { font-size: .75rem; font-weight: 700; letter-spacing: .14em; color: var(--ink); text-shadow: 0 1px 6px rgb(0 0 0 / 60%); }
  .project__body { display: flex; flex-direction: column; gap: 9px; }
  .project__name { margin: 0; font-size: clamp(1.5rem, 2.8vw, 2.4rem); font-weight: 680; letter-spacing: -.03em; }
  .project__pitch { margin: 0; font-size: clamp(.92rem, 1.2vw, 1.05rem); line-height: 1.45; color: var(--ink); }
  .project__facts { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .project__facts .chip { font-size: .7rem; padding: 4px 9px; background: rgb(0 0 0 / 35%); }
  .project__role { margin: 0; font-size: .78rem; color: var(--ink-soft); }
  .project__link {
    align-self: flex-start; margin-top: 2px; font-size: .85rem; font-weight: 650; text-decoration: none;
    color: #04140b; background: var(--accent); padding: 8px 14px; border-radius: 999px; transition: transform .2s ease;
  }
  .project__link:hover { transform: translateY(-2px); }
  .project__soon { margin: 2px 0 0; font-size: .8rem; color: rgb(185 255 215 / 90%); }
  @media (max-width: 620px) {
    .projects { grid-template-columns: 1fr; }
    /* Keep them square, with a little more room for copy on narrow phones. */
    .project { aspect-ratio: auto; min-height: min(100vw - 32px, 440px); }
  }
  .upcoming {
    margin-top: 18px; border-radius: 26px; padding: 16px; display: grid; grid-template-columns: 220px 1fr auto;
    gap: clamp(16px, 2.4vw, 28px); align-items: center;
  }
  .upcoming__shot { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: 30% 50%; border-radius: 16px; opacity: .9; }
  .upcoming__body { display: flex; flex-direction: column; gap: 8px; }
  .upcoming__meta { margin: 0; display: flex; gap: 12px; align-items: center; }
  .upcoming__soon { margin: 0; padding-right: 10px; white-space: nowrap; }
  .upcoming__cta { align-self: center; margin: 0 10px 0 0; white-space: nowrap; }
  @media (max-width: 820px) {
    .upcoming { grid-template-columns: 1fr; }
    .upcoming__soon, .upcoming__cta { white-space: normal; margin: 0; }
    .upcoming__cta { justify-self: start; }
  }
  @media (prefers-reduced-motion: reduce) { .project, .project__shot { transition: none; } }
</style>
