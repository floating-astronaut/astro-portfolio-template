---
import { proof } from '~/data/profile';
import { site } from '~/lib/site';
// The first word sits on line one; the rest gets the accent gradient.
const [first, ...others] = site.name.split(' ');
const rest = others.join(' ');
---
<section class="hero section" id="top" aria-labelledby="hero-title">
  <p class="section__kicker reveal">{site.role} · {site.status.split(' · ').pop()}</p>
  <h1 id="hero-title" class="hero__title reveal">{first}<br /><span>{rest}</span></h1>
  <p class="section__lede hero__lede reveal">One or two sentences on what you do, who you do it for, and the proof. Keep it short — the stats below carry the numbers.</p>
  <div class="hero__ctas reveal">
    <a class="btn btn--primary" href="#projects">See my work</a>
    <a class="btn btn--ghost" href="#contact">Get in touch</a>
  </div>
  <ul class="hero__proof reveal" role="list">
    {proof.map((item) => (
      <li class="glass hero__stat" data-tilt><strong>{item.value}</strong><span>{item.label}</span></li>
    ))}
  </ul>
</section>
<style>
  .hero { min-height: 92svh; display: flex; flex-direction: column; justify-content: center; padding-top: 120px; padding-bottom: 32px; }
  .hero__title { margin: 0; font-size: clamp(3rem, 9vw, 7.5rem); font-weight: 700; line-height: .92; letter-spacing: -.045em; }
  .hero__title span { background: linear-gradient(100deg, #b9ffd7, var(--accent) 60%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hero__lede { font-size: clamp(1.05rem, 1.6vw, 1.3rem); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .hero__proof { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin: 48px 0 0; padding: 0; list-style: none; max-width: 860px; }
  .hero__stat { border-radius: 18px; padding: 16px 18px; display: grid; gap: 4px; }
  .hero__stat strong { font-size: clamp(1.4rem, 2.6vw, 2rem); font-weight: 700; letter-spacing: -.02em; color: var(--accent); }
  .hero__stat span { font-size: .82rem; color: var(--ink-soft); }
  @media (max-width: 720px) { .hero__proof { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
