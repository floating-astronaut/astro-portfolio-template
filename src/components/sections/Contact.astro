---
import { site } from '~/lib/site';
---
<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="glass contact__card reveal" data-tilt>
    <img class="contact__avatar" src="/assets/brand/avatar-192.png" alt="" width="96" height="96" loading="lazy" decoding="async" />
    <p class="section__kicker">Contact</p>
    <h2 id="contact-title" class="section__title contact__title">Let's work together.</h2>
    <p class="section__lede contact__lede">Say what you're open to: roles, freelance projects, collaborations, or just a hello.</p>
    <div class="contact__actions">
      <a class="btn btn--primary" href={`mailto:${site.contactEmail}`}>Email me</a>
      <a class="btn btn--ghost" href={site.linkedin} target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">↗</span></a>
      <a class="btn btn--ghost" href={site.github} target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a>
    </div>
    <p class="contact__email">{site.contactEmail}</p>
  </div>
</section>
<style>
  .contact { padding-bottom: 16px; }
  .contact__card { border-radius: 32px; padding: clamp(28px, 5vw, 56px); text-align: center; display: flex; flex-direction: column; align-items: center; }
  .contact__avatar { width: 96px; height: 96px; border-radius: 50%; image-rendering: pixelated; margin-bottom: 18px;
    background: radial-gradient(circle at 50% 35%, #1d5c38, #0a2215 70%); box-shadow: 0 0 0 2px rgb(61 255 143 / 55%), 0 0 30px rgb(61 255 143 / 30%); }
  .contact__title { max-width: 20ch; }
  .contact__lede { margin-inline: auto; }
  .contact__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 28px; }
  .contact__email { margin: 18px 0 0; font-size: .85rem; color: var(--ink-soft); }
</style>
