---
import type { Capability } from '~/data/capabilities';
interface Props { id: string; kicker: string; title: string; lede: string; items: Capability[] }
const { id, kicker, title, lede, items } = Astro.props;
---
<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <p class="section__kicker reveal">{kicker}</p>
  <h2 id={`${id}-title`} class="section__title reveal">{title}</h2>
  <p class="section__lede reveal">{lede}</p>
  <ul class="grid grid--3 caps" role="list">
    {items.map((item, index) => (
      <li class="glass panel cap reveal" data-tilt style={`--i:${index}`}>
        <span class="cap__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <h3 class="cap__title">{item.title}</h3>
        <p class="cap__body">{item.body}</p>
        <p class="cap__proof"><span aria-hidden="true">↳</span> {item.proof}</p>
      </li>
    ))}
  </ul>
</section>
<style>
  .caps { list-style: none; padding: 0; margin-bottom: 0; }
  .cap { display: flex; flex-direction: column; gap: 10px; transition: transform .35s ease, border-color .35s ease; transition-delay: calc(var(--i) * 60ms); }
  .cap:hover { transform: translateY(-4px); border-color: rgb(61 255 143 / 35%); }
  .cap__index { font-size: .72rem; font-weight: 700; letter-spacing: .14em; color: var(--accent); }
  .cap__title { margin: 0; font-size: 1.15rem; font-weight: 650; letter-spacing: -.01em; }
  .cap__body { margin: 0; font-size: .93rem; line-height: 1.55; color: var(--ink-soft); flex: 1; }
  .cap__proof { margin: 6px 0 0; font-size: .78rem; font-weight: 600; color: rgb(185 255 215 / 85%); }
</style>
