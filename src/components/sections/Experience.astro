---
import { experience, education, certifications, languages } from '~/data/profile';
// Show the degrees that matter on a résumé; schooling stays in the data.
const degrees = education.slice(0, 3);
const initials = (name: string) => name.split(/\s+/).filter((w) => /^[A-Z]/.test(w)).slice(0, 2).map((w) => w[0]).join('');
---
<section class="section" id="experience" aria-labelledby="experience-title">
  <p class="section__kicker reveal">Experience</p>
  <h2 id="experience-title" class="section__title reveal">Where I've done the work.</h2>
  <ol class="roles" role="list">
    {experience.map((role) => (
      <li class="glass role reveal" data-tilt>
        <div class="role__head">
          <div>
            <h3 class="role__title">{role.role}</h3>
            <p class="role__org">{role.org} <span aria-hidden="true">·</span> <span class="role__place">{role.place}</span></p>
          </div>
          <p class="role__period">{role.period}</p>
        </div>
        <details class="role__details">
          <summary>Details</summary>
          <p>{role.summary}</p>
          <ul>{role.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
        </details>
      </li>
    ))}
  </ol>

  <div class="creds">
    <div class="glass panel reveal" data-tilt>
      <h3 class="creds__title">Education</h3>
      <ul class="degrees" role="list">
        {degrees.map((school) => (
          <li class="degree">
            <span class="degree__logo">{school.logo
              ? <img src={school.logo} alt="" width="48" height="48" loading="lazy" decoding="async" />
              : <span class="degree__initials" aria-hidden="true">{initials(school.school)}</span>}</span>
            <span><strong>{school.school}</strong><br /><span class="degree__meta">{school.credential} · {school.period}</span></span>
          </li>
        ))}
      </ul>
    </div>
    <div class="glass panel reveal" data-tilt>
      <h3 class="creds__title">Certifications</h3>
      <ul class="chips" role="list">{certifications.map((cert) => <li class="chip">{cert}</li>)}</ul>
      <h3 class="creds__title creds__title--spaced">Languages</h3>
      <ul class="chips" role="list">{languages.map((language) => <li class="chip">{language}</li>)}</ul>
    </div>
  </div>
</section>
<style>
  .degree__initials { font-weight: 700; font-size: .95rem; letter-spacing: .04em; color: #04140b; }
  .roles { list-style: none; padding: 0; margin: clamp(22px, 3vw, 36px) 0 0; display: grid; gap: 12px; }
  .role { border-radius: 20px; padding: 18px 22px; }
  .role__head { display: flex; justify-content: space-between; gap: 16px; align-items: baseline; }
  .role__title { margin: 0; font-size: 1.1rem; font-weight: 650; }
  .role__org { margin: 4px 0 0; color: var(--ink); font-size: .95rem; }
  .role__place { color: var(--ink-soft); }
  .role__period { margin: 0; font-size: .82rem; font-weight: 600; color: var(--accent); white-space: nowrap; }
  .role__details { margin-top: 10px; }
  .role__details summary { cursor: pointer; font-size: .82rem; font-weight: 600; color: var(--ink-soft); width: fit-content; }
  .role__details summary:hover { color: var(--ink); }
  .role__details p, .role__details li { font-size: .92rem; line-height: 1.55; color: var(--ink-soft); }
  .role__details ul { margin: 0; padding-left: 1.1rem; }
  .creds { display: grid; grid-template-columns: 1.2fr 1fr; gap: 14px; margin-top: 14px; }
  .creds__title { margin: 0 0 14px; font-size: .8rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); }
  .creds__title--spaced { margin-top: 22px; }
  .degrees { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  .degree { display: flex; gap: 14px; align-items: center; font-size: .95rem; line-height: 1.35; }
  .degree__logo { flex: none; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 14px; background: #fff; overflow: hidden; }
  .degree__logo img { width: 44px; height: 44px; object-fit: contain; }
  .degree__meta { font-size: .82rem; color: var(--ink-soft); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 0; }
  @media (max-width: 820px) {
    .creds { grid-template-columns: 1fr; }
    .role__head { flex-direction: column; gap: 6px; }
  }
</style>
