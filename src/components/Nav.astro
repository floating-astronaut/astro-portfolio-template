---
import { nav, site } from '~/lib/site';
import SocialIcons from '~/components/SocialIcons.astro';
---
<a href="#main" class="skip-link">Skip to content</a>
<header id="site-nav">
  <div class="mx-auto mt-2 w-[min(calc(100%-1rem),var(--container-max))] rounded-2xl border border-border/60 bg-[linear-gradient(180deg,rgb(var(--color-bg)/0.82),rgb(var(--color-surface)/0.68))] shadow-[0_18px_44px_-28px_rgba(0,0,0,0.85)] backdrop-blur-xl">
  <div class="container-app flex h-[var(--nav-h)] items-center justify-between">
    <a href="/" class="flex min-h-11 items-center gap-3 font-semibold whitespace-nowrap" aria-label={`${site.name} home`}>
      <img src="/assets/brand/mark-128.png" alt="" width="36" height="36" class="h-9 w-9 rounded-full border border-brand/40 object-cover" loading="eager" decoding="async" />
      <span class="text-fluid-base">Your <span class="text-brand">Name</span></span>
    </a>
    <nav aria-label="Primary" class="hidden items-center gap-7 text-fluid-sm text-muted md:flex">
      {nav.map((item) => <a href={item.href} class="whitespace-nowrap hover:text-brand transition-colors">{item.label}</a>)}
    </nav>
    <div class="hidden items-center gap-3 md:flex">
      <a href="#contact" class="btn btn-ghost whitespace-nowrap">Start a conversation</a>
    </div>
    <button id="mobile-nav-toggle" type="button" class="md:hidden inline-flex min-h-11 min-w-11 items-center justify-center rounded-md text-fg hover:text-brand" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-nav-drawer">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path data-ham-lines d="M4 7h16M4 12h16M4 17h16" /><path data-ham-x class="hidden" d="M6 6l12 12M6 18L18 6" /></svg>
    </button>
  </div>
  </div>
</header>
<div id="mobile-nav-drawer" class="fixed inset-x-0 bottom-0 z-40 hidden flex-col bg-bg/98 backdrop-blur-xl md:hidden" style="top: var(--nav-h);" aria-hidden="true">
  <nav aria-label="Mobile primary" class="container-app flex flex-col divide-y divide-border/50 pt-4">
    {nav.map((item) => <a href={item.href} class="flex min-h-[56px] items-center justify-between text-fluid-xl font-medium hover:text-brand" data-mobile-nav-link>{item.label}<span class="text-brand">-&gt;</span></a>)}
  </nav>
  <div class="container-app mt-6 grid gap-5 pb-8">
    <SocialIcons label="Mobile social profiles" />
    <a href="#contact" class="btn btn-primary w-full justify-center" data-mobile-nav-link>Start a conversation</a>
  </div>
</div>
<script>
  const toggle = document.getElementById('mobile-nav-toggle');
  const drawer = document.getElementById('mobile-nav-drawer');
  function setDrawer(open: boolean) {
    if (!toggle || !drawer) return;
    toggle.setAttribute('aria-expanded', String(open));
    drawer.setAttribute('aria-hidden', String(!open));
    drawer.classList.toggle('hidden', !open);
    drawer.classList.toggle('flex', open);
    document.body.classList.toggle('overflow-hidden', open);
    toggle.querySelector('[data-ham-lines]')?.classList.toggle('hidden', open);
    toggle.querySelector('[data-ham-x]')?.classList.toggle('hidden', !open);
  }
  toggle?.addEventListener('click', () => setDrawer(toggle.getAttribute('aria-expanded') !== 'true'));
  drawer?.querySelectorAll('[data-mobile-nav-link]').forEach((link) => link.addEventListener('click', () => setDrawer(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setDrawer(false); });
</script>
