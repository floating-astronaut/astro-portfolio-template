---
// Real brand marks (full-colour, from the @iconify-json/logos set), rendered to
// inline SVG at build time — no client JS. Two floating glass rows drifting in
// opposite directions.
import { icons } from '@iconify-json/logos';
import { getIconData, iconToSVG, iconToHTML, replaceIDs } from '@iconify/utils';

// Marks that are black in the official artwork and vanish on the dark glass.
const MONO = new Set(['expo-icon', 'elevenlabs', 'astro-icon']);
const rows = [
  { label: 'Market with', tools: [
    ['meta-icon', 'Meta Ads'], ['google-ads', 'Google Ads'], ['tiktok-icon', 'TikTok'], ['shopify', 'Shopify'],
    ['google-analytics', 'GA4'], ['google-tag-manager', 'Google Tag Manager'], ['whatsapp-icon', 'WhatsApp'], ['hubspot', 'HubSpot'],
  ] },
  { label: 'Build with', tools: [
    ['claude-icon', 'Claude'], ['python', 'Python'], ['fastapi-icon', 'FastAPI'], ['react', 'React'], ['astro-icon', 'Astro'],
    ['typescript-icon', 'TypeScript'], ['supabase-icon', 'Supabase'], ['postgresql', 'PostgreSQL'], ['cloudflare-icon', 'Cloudflare'],
    ['google-cloud', 'Google Cloud'], ['stripe', 'Stripe'], ['twilio-icon', 'Twilio'], ['elevenlabs', 'ElevenLabs'], ['swift', 'Swift'], ['expo-icon', 'Expo'],
  ] },
];
const svg = (id: string) => {
  const data = getIconData(icons, id);
  if (!data) throw new Error(`Missing logo: ${id}`);
  const { attributes, body } = iconToSVG(data, { height: 'auto' });
  return iconToHTML(replaceIDs(body), { ...attributes, 'aria-hidden': 'true', focusable: 'false' });
};
const rendered = rows.map((row) => ({ ...row, tools: row.tools.map(([id, name]) => ({ id, name, html: svg(id) })) }));
---
<section class="logos" aria-label="Platforms and tools I use">
  {rendered.map((row, index) => (
    <div class="glass logos__row reveal">
      <p class="logos__label">{row.label}</p>
      <div class="logos__window">
        <div class:list={['logos__track', { 'logos__track--reverse': index === 1 }]}>
          {[0, 1].map((copy) => (
            <ul class="logos__group" role="list" aria-hidden={copy === 1 ? 'true' : undefined}>
              {row.tools.map((tool) => (
                <li class:list={['logos__tile', { 'logos__tile--mono': MONO.has(tool.id) }]} title={tool.name}>
                  <Fragment set:html={tool.html} />
                  <span class="visually-hidden">{tool.name}</span>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </div>
  ))}
</section>
<style>
  .logos { width: min(1120px, calc(100% - 32px)); margin: 0 auto; padding-block: 8px 0; display: grid; gap: 12px; }
  .logos__row {
    position: relative; display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 18px;
    border-radius: 999px; padding: 10px 10px 10px 24px;
    animation: logos-float 9s ease-in-out infinite;
  }
  .logos__row:nth-child(2) { animation-delay: -4.5s; margin-left: clamp(0px, 6vw, 72px); }
  .logos__label { margin: 0; font-size: .72rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--accent); white-space: nowrap; }
  .logos__window {
    overflow: hidden; min-width: 0;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .logos__track { display: flex; width: max-content; animation: logos-scroll 42s linear infinite; }
  .logos__track--reverse { animation-direction: reverse; animation-duration: 58s; }
  .logos__window:hover .logos__track { animation-play-state: paused; }
  .logos__group { display: flex; gap: 10px; padding: 0 10px 0 0; margin: 0; list-style: none; }
  .logos__tile {
    display: grid; place-items: center; width: 76px; height: 50px; border-radius: 14px;
    background: rgb(255 255 255 / 6%); border: 1px solid rgb(255 255 255 / 8%);
    transition: transform .25s ease, background .25s ease;
  }
  .logos__tile:hover { transform: translateY(-3px); background: rgb(255 255 255 / 12%); }
  .logos__tile :global(svg) { height: 28px; width: auto; max-width: 56px; }
  .logos__tile--mono :global(svg) { filter: brightness(0) invert(1); opacity: .9; }
  @keyframes logos-scroll { to { transform: translateX(-50%); } }
  @keyframes logos-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
  @media (max-width: 620px) {
    .logos__row { grid-template-columns: 1fr; border-radius: 22px; padding: 14px; gap: 10px; }
    .logos__row:nth-child(2) { margin-left: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .logos__row { animation: none; }
    .logos__track { animation: none; width: auto; }
    .logos__group { flex-wrap: wrap; }
    .logos__group[aria-hidden] { display: none; }
  }
</style>
