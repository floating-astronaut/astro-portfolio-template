---
import { site } from '~/lib/site';
const sections = [
  { id: 'skills', label: 'Skills' },
  { id: 'craft', label: 'Craft' },
  { id: 'projects', label: 'Projects' },
  { id: 'experience', label: 'Experience' },
];
---
<header class="float-header glass" data-float-header>
  <a class="float-header__brand" href="/" aria-label={`${site.name} — home`}>
    <span class="float-header__mark" aria-hidden="true">
      <img src="/assets/brand/avatar-96.png" srcset="/assets/brand/avatar-96.png 1x, /assets/brand/avatar-192.png 2x" alt="" width="40" height="40" decoding="async" />
    </span>
    <span class="float-header__name">{site.name}</span>
  </a>
  <nav class="float-header__chapters" aria-label="Sections">
    {sections.map((section) => (
      <a class="float-header__dot" href={`#${section.id}`} data-section-link={section.id}>{section.label}</a>
    ))}
  </nav>
  <a class="float-header__cta" href={`mailto:${site.contactEmail}`}>Contact</a>
</header>
<script>
  const header = document.querySelector<HTMLElement>('[data-float-header]');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-section-link]')];

  // Highlight the section currently in view. Smooth scrolling for these anchors
  // comes from the shared smooth-scroll module (Lenis on desktop).
  const targets = links.map((link) => document.getElementById(link.dataset.sectionLink!)).filter(Boolean) as HTMLElement[];
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      links.forEach((link) => link.toggleAttribute('aria-current', link.dataset.sectionLink === entry.target.id));
    }), { rootMargin: '-45% 0px -50% 0px' });
    targets.forEach((target) => io.observe(target));
  }

  // Tighten slightly once the visitor starts scrolling.
  const onScroll = (): void => { header?.toggleAttribute('data-scrolled', window.scrollY > 24); };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
<style>
  .float-header {
    position: fixed; z-index: 20; top: max(16px, env(safe-area-inset-top)); left: 50%;
    transform: translateX(-50%);
    width: min(1120px, calc(100% - 32px));
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 10px 10px 10px 18px; border-radius: 999px;
    transition: padding .35s ease, width .35s ease, background .35s ease;
    animation: header-in .8s cubic-bezier(.2,.7,.2,1) both;
  }
  .float-header[data-scrolled] { width: min(980px, calc(100% - 32px)); padding-block: 7px; }
  .float-header__brand { display: flex; align-items: center; gap: 10px; text-decoration: none; min-width: 0; }
  .float-header__mark {
    position: relative; display: block; flex: none; width: 40px; height: 40px; border-radius: 50%; overflow: hidden;
    background: radial-gradient(circle at 50% 35%, #1d5c38, #0a2215 70%);
    box-shadow: 0 0 0 1.5px rgb(61 255 143 / 55%), 0 0 18px rgb(61 255 143 / 30%);
    transition: transform .3s ease, box-shadow .3s ease;
  }
  .float-header__mark img {
    width: 100%; height: 100%; display: block; object-fit: cover; object-position: 50% 30%;
    image-rendering: pixelated; transform: scale(1.08) translateY(2px);
  }
  .float-header__brand:hover .float-header__mark { transform: rotate(-4deg) scale(1.06); box-shadow: 0 0 0 1.5px var(--accent), 0 0 24px rgb(61 255 143 / 45%); }
  .float-header__name { font-weight: 600; font-size: .95rem; letter-spacing: -.01em; white-space: nowrap; }
  .float-header__chapters { display: flex; gap: 4px; }
  .float-header__dot {
    border: 0; background: transparent; color: var(--ink-soft); cursor: pointer; text-decoration: none;
    font: 600 .82rem/1 var(--font-ui); letter-spacing: .01em;
    padding: 9px 10px; border-radius: 999px; transition: color .25s, background .25s;
  }
  .float-header__dot:hover { color: var(--ink); background: rgb(255 255 255 / 6%); }
  .float-header__dot[aria-current] { color: #04140b; background: var(--accent); }
  .float-header__cta {
    text-decoration: none; font-weight: 600; font-size: .88rem; padding: 10px 18px; border-radius: 999px;
    background: rgb(255 255 255 / 92%); color: #06110b; transition: transform .2s ease, background .2s ease;
  }
  .float-header__cta:hover { transform: translateY(-1px); background: #fff; }
  @keyframes header-in { from { opacity: 0; transform: translate(-50%, -14px); } to { opacity: 1; transform: translate(-50%, 0); } }
  @media (max-width: 720px) {
    .float-header { padding-left: 10px; gap: 8px; }
    .float-header__name { display: none; }
    .float-header__dot { padding: 8px 6px; font-size: .72rem; }
    .float-header__cta { padding: 9px 13px; font-size: .8rem; }
  }
  @media (max-width: 400px) { .float-header__dot { padding: 8px 4px; font-size: .68rem; } .float-header__cta { padding: 9px 11px; } }
  @media (prefers-reduced-motion: reduce) { .float-header { animation: none; transition: none; } }
</style>
