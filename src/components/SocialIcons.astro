---
import { socialLinks } from '~/lib/site';
interface Props { label?: string; align?: 'start' | 'center' }
const { label = 'Social profiles', align = 'start' } = Astro.props;
---
<nav class:list={['socials', `socials--${align}`]} aria-label={label}>
  <ul role="list">
    {socialLinks.map((item) => (
      <li>
        <a href={item.href} target="_blank" rel="noopener" aria-label={item.name} title={item.name}>
          <!-- Icon drawn as a mask so it takes the link colour (and turns green on hover). -->
          <span class="socials__icon" aria-hidden="true" style={`--icon: url('${item.icon}')`}></span>
        </a>
      </li>
    ))}
  </ul>
</nav>
<style>
  .socials ul { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .socials--center ul { justify-content: center; }
  .socials a {
    display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%;
    color: var(--ink); background: rgb(255 255 255 / 7%); border: 1px solid rgb(255 255 255 / 10%);
    transition: color .2s ease, background .2s ease, transform .2s ease, border-color .2s ease;
  }
  .socials a:hover { color: #04140b; background: var(--accent); border-color: transparent; transform: translateY(-2px); }
  .socials__icon {
    width: 17px; height: 17px; background: currentColor;
    -webkit-mask: var(--icon) center / contain no-repeat; mask: var(--icon) center / contain no-repeat;
  }
</style>
