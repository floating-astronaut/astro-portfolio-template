---
import { site } from '~/lib/site';
import { projects } from '~/data/projects';
import SocialIcons from '~/components/SocialIcons.astro';
const year = new Date().getFullYear();
const explore = [
  { href: '#top', label: 'Home' },
  { href: '#skills', label: 'Skills' },
  { href: '#craft', label: 'Craft' },
  { href: '#projects', label: 'Projects' },
  { href: '#experience', label: 'Experience' },
  { href: '#contact', label: 'Contact' },
];
const connect = [
  { label: 'Email', href: `mailto:${site.contactEmail}`, path: 'M3 5.5h18a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1v-11a1 1 0 0 1 1-1Zm.9 2.1v.2l8.1 5.4 8.1-5.4v-.2H3.9Zm16.2 2.6-7.55 5.03a1 1 0 0 1-1.1 0L3.9 10.2v6.2h16.2v-6.2Z' },
  { label: 'GitHub', href: site.github, path: 'M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.56 9.56 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z' },
  { label: 'GitLab', href: site.gitlab, path: 'm21.9 13.4-1.1-3.3-2.2-6.7a.6.6 0 0 0-1.1 0l-2.2 6.7H8.7L6.5 3.4a.6.6 0 0 0-1.1 0l-2.2 6.7-1.1 3.3a1.1 1.1 0 0 0 .4 1.3L12 21.4l9.5-6.7a1.1 1.1 0 0 0 .4-1.3Z' },
];
const external = (href: string) => !href.startsWith('#') && !href.startsWith('mailto:');
---
<footer class="float-footer-zone">
  <div class="float-footer glass">
    <div class="float-footer__grid">
      <div class="float-footer__brand">
        <a class="float-footer__id" href="#top" aria-label={`${site.name} — back to top`}>
          <img src="/assets/brand/avatar-96.png" srcset="/assets/brand/avatar-96.png 1x, /assets/brand/avatar-192.png 2x" alt="" width="44" height="44" loading="lazy" decoding="async" />
          <span>{site.name}</span>
        </a>
        <p class="float-footer__tagline">{site.tagline}</p>
        <p class="float-footer__status"><span class="float-footer__dot" aria-hidden="true"></span> {site.status}</p>
        <div class="float-footer__socials"><SocialIcons label="Footer: social profiles" /></div>
      </div>
      <nav class="float-footer__col" aria-label="Footer: explore">
        <h2>Explore</h2>
        <ul role="list">{explore.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
      </nav>
      <nav class="float-footer__col" aria-label="Footer: projects">
        <h2>Projects</h2>
        <ul role="list">{projects.filter((project) => project.href).map((project) => <li><a href={project.href} target="_blank" rel="noopener">{project.name} <span aria-hidden="true">↗</span></a></li>)}</ul>
      </nav>
      <nav class="float-footer__col" aria-label="Footer: connect">
        <h2>Connect</h2>
        <ul role="list">
          {connect.map((link) => (
            <li>
              <a href={link.href} target={external(link.href) ? '_blank' : undefined} rel={external(link.href) ? 'noopener' : undefined}>
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d={link.path} /></svg>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="float-footer__bottom">
      <p>© {year} {site.name}. All rights reserved.</p>
      <a href="#top" class="float-footer__top">Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>
<style>
  /* Sits after the film world: the film rests on its last frame while the footer floats in. */
  .float-footer-zone {
    position: relative; z-index: 10;
    display: flex; justify-content: center;
    padding: 24px 16px max(24px, env(safe-area-inset-bottom));
  }
  .float-footer {
    width: min(1120px, 100%); border-radius: 28px; padding: clamp(24px, 3.4vw, 40px);
    animation: float-bob 8s ease-in-out infinite;
  }
  .float-footer__grid { display: grid; grid-template-columns: minmax(300px, 1.6fr) 1fr 1fr 1fr; gap: clamp(24px, 4vw, 48px); }
  /* Brand column is a stack with one fixed gap, so the status line and icons can never run together. */
  .float-footer__brand { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  .float-footer__brand > * { margin: 0; }
  .float-footer__id { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; font-weight: 650; font-size: 1.05rem; }
  .float-footer__id img {
    width: 44px; height: 44px; border-radius: 50%; image-rendering: pixelated;
    background: radial-gradient(circle at 50% 35%, #1d5c38, #0a2215 70%); box-shadow: 0 0 0 1.5px rgb(61 255 143 / 55%);
  }
  .float-footer__tagline { max-width: 34ch; font-size: .92rem; line-height: 1.5; color: var(--ink-soft); }
  .float-footer__status { display: flex; align-items: center; gap: 8px; font-size: .82rem; font-weight: 600; color: rgb(185 255 215 / 90%); }
  .float-footer__socials { padding-top: 4px; }
  .float-footer__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px var(--accent); }
  .float-footer__col h2 { margin: 0 0 14px; font-size: .74rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--accent); }
  .float-footer__col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .float-footer__col a {
    display: inline-flex; align-items: center; gap: 8px; min-height: 24px;
    font-size: .92rem; color: var(--ink-soft); text-decoration: none; transition: color .2s, transform .2s;
  }
  .float-footer__col a:hover { color: var(--ink); transform: translateX(2px); }
  .float-footer__bottom {
    margin-top: clamp(24px, 3vw, 36px); padding-top: 18px; border-top: 1px solid rgb(255 255 255 / 10%);
    display: flex; justify-content: space-between; align-items: center; gap: 12px; font-size: .82rem; color: var(--ink-soft);
  }
  .float-footer__bottom p { margin: 0; }
  .float-footer__top { color: var(--ink); text-decoration: none; font-weight: 600; }
  .float-footer__top:hover { color: var(--accent); }
  @keyframes float-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
  @media (max-width: 900px) { .float-footer__grid { grid-template-columns: 1fr 1fr; } .float-footer__brand { grid-column: 1 / -1; } }
  @media (max-width: 480px) {
    .float-footer__grid { grid-template-columns: 1fr; }
    .float-footer__bottom { flex-direction: column; align-items: flex-start; }
  }
  @media (prefers-reduced-motion: reduce) { .float-footer { animation: none; } }
</style>
