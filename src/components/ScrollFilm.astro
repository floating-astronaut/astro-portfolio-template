---
// The film spans the whole page: the world wraps all content, so its height
// (and the scroll-to-film mapping) follows the content.
---
<div class="film-world">
  <div class="film-video" aria-hidden="true">
    <video muted playsinline preload="auto" tabindex="-1" aria-hidden="true"
      data-src-desktop="/media/film/film-scrub-1080.mp4"
      data-src-mobile="/media/film/film-scrub-540.mp4"></video>
    <div class="film-video__grade"></div>
    <div class="film-video__vignette"></div>
    <div class="film-video__grain"></div>
  </div>
  <span class="film-scroll-hint" aria-hidden="true">Scroll</span>
  <div class="film-content"><slot /></div>
</div>
<script>
  import '../scripts/scroll-film';
  import '../scripts/smooth-scroll';
  import 'lenis/dist/lenis.css';
</script>
<style>
  .film-world { position: relative; isolation: isolate; overflow: clip; min-height: 100vh; }
  .film-content { position: relative; z-index: 2; }
  .film-video {
    position: fixed; z-index: 0; inset: 0; overflow: hidden; pointer-events: none;
    background: #050908 url('/media/film/film-poster.jpg') center / cover no-repeat;
  }
  video {
    position: absolute; inset: 0; width: 100%; height: 100%; max-width: none;
    object-fit: cover; opacity: 0; transition: opacity 400ms ease;
  }
  .film-world.is-ready video { opacity: 1; }
  .film-video__grade, .film-video__vignette, .film-video__grain {
    position: absolute; inset: 0; pointer-events: none;
  }
  /* Dimmed so content reads over the film; --film-dim tunes it in one place. */
  .film-video__grade {
    --film-dim: .5;
    background:
      linear-gradient(90deg, rgb(3 8 7 / 35%), rgb(3 8 7 / 5%) 70%),
      rgb(3 8 7 / var(--film-dim));
  }
  .film-video__vignette { box-shadow: inset 0 0 16vw 3vw rgb(0 0 0 / 35%); }
  .film-video__grain {
    opacity: .025;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    animation: film-grain 800ms steps(4) infinite;
  }
  @keyframes film-grain { to { background-position: 160px 80px; } }
  .film-scroll-hint {
    position: fixed; z-index: 1; bottom: max(1.5rem, env(safe-area-inset-bottom));
    left: 50%; transform: translateX(-50%); color: rgb(255 255 255 / 70%);
    font-size: .75rem; letter-spacing: .12em; pointer-events: none;
    opacity: clamp(0, calc(1 - var(--film-progress, 0) * 20), 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .film-world.is-ready video { opacity: 0; }
    video { transition: none; }
    .film-video__grain { animation: none; }
  }
</style>
