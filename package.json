{
  "name": "astro-portfolio-template",
  "type": "module",
  "version": "1.0.0",
  "private": false,
  "description": "A fork-ready Astro portfolio with a scroll-scrubbed video background, floating glass UI, 3D hover-tilt cards and a brand-logo marquee. MIT.",
  "license": "MIT",
  "author": "Tejas Karan Agrawal <tejaskagrawalgwl@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/floating-astronaut/astro-portfolio-template.git"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "astro check",
    "test": "playwright test",
    "test:install": "playwright install --with-deps chromium",
    "schemas:validate": "tsx scripts/validate-schemas.ts",
    "links:audit": "tsx scripts/link-audit.ts",
    "test:unit": "vitest run",
    "film:demo": "bash media-src/demo-clips.sh && bash media-src/build-film.sh media-src/clips/{1,2,3,4,5}.mp4",
    "assets:placeholder": "node media-src/placeholder-assets.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@iconify-json/logos": "^1.2.15",
    "@iconify/utils": "^3.1.7",
    "astro": "^7.3.5",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.9.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
